{
  "version": "multi_reward_full_scoring_v2",
  "output_root": "data/cache/reward_scores_full_v1",
  "manifest_root": "data/manifests",
  "models": {
    "qwen3_1p7b": {
      "name": "Skywork-Reward-V2-Qwen3-1.7B",
      "path": "models/reward/Skywork-Reward-V2-Qwen3-1.7B",
      "initial_batch_size": 32
    },
    "qwen3_4b": {
      "name": "Skywork-Reward-V2-Qwen3-4B",
      "path": "models/reward/Skywork-Reward-V2-Qwen3-4B",
      "initial_batch_size": 16
    },
    "llama_8b_v2": {
      "name": "Skywork-Reward-V2-Llama-3.1-8B",
      "path": "models/reward/Skywork-Reward-V2-Llama-3.1-8B",
      "initial_batch_size": 8
    },
    "armorm_8b": {
      "name": "ArmoRM-Llama3-8B-v0.1",
      "path": "models/reward/ArmoRM-Llama3-8B-v0.1",
      "initial_batch_size": 8
    }
  },
  "splits": [
    {
      "name": "gsm_pilot",
      "file": "data/processed/prototype_v2/gsm_pilot_validation.jsonl"
    },
    {
      "name": "math_pilot",
      "file": "data/processed/prototype_v2/math_pilot_validation.jsonl"
    },
    {
      "name": "gsm_id_test",
      "file": "data/processed/prototype_v2/gsm_id_test_mixed.jsonl"
    },
    {
      "name": "math_id_test",
      "file": "data/processed/prototype_v2/math_id_test_mixed.jsonl"
    },
    {
      "name": "svamp_ood",
      "file": "data/processed/prototype_v2/svamp_ood_mixed.jsonl"
    },
    {
      "name": "gsm_train",
      "file": "data/processed/prototype_v2/gsm_train.jsonl"
    },
    {
      "name": "math_train",
      "file": "data/processed/prototype_v2/math_train.jsonl"
    }
  ],
  "scoring": {
    "input": "chat_template(user=problem, assistant=solution_text)",
    "output": "single sequence-classification logit",
    "dtype": "bfloat16",
    "use_cache": false,
    "sorting": "character_length",
    "checkpoint": "numpy memmap after every batch",
    "labels_used": false
  }
}
